{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::ci-cache"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::ci-cache/gh-actions-cache/*"
      ],
      "Condition": {
        "StringLike": {
          "jwt:preferred_username": [
            "k8s-actions-cache-github-actions-cache-server"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::ci-cache/gh-actions-cache/*"
      ],
      "Condition": {
        "StringLike": {
          "jwt:preferred_username": [
            "k8s-actions-cache-github-actions-cache-server"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "admin:*"
      ]
    }
  ]
}
