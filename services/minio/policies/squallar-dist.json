{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::squallar-dist"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::squallar-dist/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::squallar-dist/main/*"
      ],
      "Condition": {
        "StringLike": {
          "jwt:preferred_username": [
            "gha-squallar-main"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "admin:*"
      ]
    }
  ]
}
