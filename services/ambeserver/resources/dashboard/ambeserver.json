        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_requests_answered_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "answered"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_requests_late_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "late"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_requests_dropped_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "busy"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_requests_refused_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval])) - sum(rate(ambeserver_requests_malformed_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "D",
          "range": true,
          "instant": false,
          "legendFormat": "rate refused"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_requests_malformed_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "E",
          "range": true,
          "instant": false,
          "legendFormat": "malformed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ambeserver_datagrams_rejected_total{namespace=\"ambeserver\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "F",
          "range": true,
          "instant": false,
          "legendFormat": "rejected datagrams"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Every request ends in one of these. late: waited over clients.max-delay. busy: the client already had four waiting. rate refused: asked for a rate other than 33 or 34. malformed: not a usable packet. rejected: no chip and no packet start byte."
    },
