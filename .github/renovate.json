{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs"
    ],
    "gitIgnoredAuthors": [
        "198527162+github-actions[bot]@users.noreply.github.com"
    ],
    "rebaseWhen": "auto",
    "flux": {
        "enabled": true,
        "managerFilePatterns": [
            "/\\.ya?ml$/"
        ]
    },
    "helm-values": {
        "enabled": true,
        "managerFilePatterns": [
            "/\\.ya?ml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)kube-system\\/etcd-(backup|defrag)\\.yaml/"
            ],
            "matchStrings": [
                "github\\.com\\/siderolabs\\/talos\\/releases\\/download\\/(?<currentValue>v.*)\\/talosctl-linux-amd64"
            ],
            "depNameTemplate": "siderolabs/talos",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)\\.github\\/workflows\\/pre-commit\\.yaml$/"
            ],
            "matchStrings": [
                "github\\.com\\/grafana\\/loki\\/releases\\/download\\/(?<currentValue>v.*)\\/lokitool-linux-amd64"
            ],
            "depNameTemplate": "grafana/loki",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.yaml$/"
            ],
            "matchStrings": [
                "imageName: ['\"]?(?<depName>.+?):(?<currentValue>.+)['\"]?"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)apps\\/renovate-ce\\/values\\.yaml/"
            ],
            "matchStrings": [
                "repository:\\s+(?<depName>.*)\\n\\s*version:\\s+(?<currentValue>.*)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "semver-coerced"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)apps\\/sensy-zone-editor\\/values\\.yaml/"
            ],
            "matchStrings": [
                "SENSY_VERSION=\"(?<currentValue>v[0-9.]+)\""
            ],
            "depNameTemplate": "sensy-one/S1",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": false
        },
        {
            "description": "prometheus-operator derives spec.version from the image tag and rejects a digest there, which silently halts reconciliation of the Prometheus and Alertmanager CRs (no ServiceMonitor or PrometheusRule changes get applied). The node-exporter subchart runs semverCompare on its tag, so a digest there fails every kube-prometheus-stack upgrade. Keep these tags bare; every other image in this chart pins normally.",
            "matchFileNames": [
                "**/infrastructure/prometheus/app/values.yaml"
            ],
            "matchManagers": [
                "helm-values"
            ],
            "matchPackageNames": [
                "/prometheus\\/(prometheus|alertmanager|node-exporter)$/"
            ],
            "pinDigests": false
        },
        {
            "automerge": false,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/papermc$/"
            ]
        },
        {
            "description": "Forge server is pinned to the modpack's Minecraft version; mods break on any other version. Only digest updates of 1.20.1 are allowed.",
            "automerge": false,
            "allowedVersions": "/^1\\.20\\.1$/",
            "matchPackageNames": [
                "/usa-reddragon\\/forge$/"
            ]
        },
        {
            "description": "SymmetricDS in the cluster must be upgraded together with the observatory PC's install (a Windows service, not managed here); 3.18 also changed engine startup in ways that took sync down. Only digest updates of 3.18.1 are allowed.",
            "automerge": false,
            "allowedVersions": "/^3\\.18\\.1$/",
            "matchPackageNames": [
                "/usa-reddragon\\/symmetricds$/"
            ]
        },
        {
            "automerge": false,
            "allowedVersions": "<=1.19.2",
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/fabric$/"
            ]
        },
        {
            "allowedVersions": "<=100",
            "matchPackageNames": [
                "/^docker.io\\/grafana\\/grafana$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/mesh-base$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/mc-mcswain-dev$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/meshmap$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/trunk-recorder-soapysdrplay3-prometheus$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/hertzg\\/rtl_433_docker$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "digest",
                "pinDigest"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/mqtt-wx$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": true,
            "matchPackageNames": [
                "/kube-prometheus-stack/"
            ]
        },
        {
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": false,
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ]
        },
        {
            "description": "Envoy Gateway ships breaking changes in minor releases; require manual review",
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": false,
            "matchPackageNames": [
                "gateway-helm"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<build>\\d+)$"
        },
        {
            "description": "Path of Titans tags are <build>h<hotfix>, e.g. 48554h25",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/usa-reddragon/path-of-titans"
            ],
            "versioning": "regex:^(?<major>\\d+)h(?<minor>\\d+)$"
        },
        {
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": false,
            "matchPackageNames": [
                "/^lscr.io\\/linuxserver\\/ffmpeg$/"
            ]
        },
        {
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": false,
            "matchPackageNames": [
                "/^ghcr.io\\/goauthentik\\/server$/"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "versioning": "regex:^version-(?<major>\\d+).(?<minor>\\d+)-cli$",
            "matchPackageNames": [
                "/^lscr.io\\/linuxserver\\/ffmpeg$/"
            ]
        },
        {
            "schedule": [
                "after 4:00am, before 7:00am"
            ],
            "matchPackageNames": [
                "/^ghcr.io\\/usa-reddragon\\/palworld-server-docker$/",
                "/^palworld$/"
            ]
        },
        {
            "automerge": false,
            "allowedVersions": "<=500",
            "matchPackageNames": [
                "/^longhornio\\/longhorn-engine$/"
            ]
        },
        {
            "groupName": "Longhorn",
            "matchDatasources": [
                "docker",
                "helm"
            ],
            "matchPackageNames": [
                "longhorn",
                "longhornio/longhorn-engine",
                "longhornio/longhorn-manager",
                "longhornio/longhorn-ui",
                "longhornio/longhorn-instance-manager",
                "longhornio/longhorn-share-manager",
                "longhornio/backing-image-manager",
                "longhornio/support-bundle-kit",
                "longhornio/csi-attacher",
                "longhornio/csi-provisioner",
                "longhornio/csi-node-driver-registrar",
                "longhornio/csi-resizer",
                "longhornio/csi-snapshotter",
                "longhornio/livenessprobe",
                "longhornio/openshift-origin-oauth-proxy"
            ]
        },
        {
            "groupName": "Renovate",
            "matchDatasources": [
                "docker",
                "helm"
            ],
            "matchPackageNames": [
                "mend-renovate-enterprise-edition",
                "ghcr.io/usa-reddragon/renovate-ee-worker",
                "ghcr.io/usa-reddragon/renovate-ee"
            ]
        },
        {
            "description": "ARC deletes AutoscalingRunnerSets whose chart version differs from the controller's, so upgrade the controller and the scale sets together",
            "groupName": "actions-runner-controller",
            "matchPackageNames": [
                "/gha-runner-scale-set/"
            ]
        },
        {
            "matchPackageNames": [
                "ghcr.io/fluxcd/flux-manifests",
                "fluxcd/flux2",
                "ghcr.io/fluxcd/flux-cli"
            ],
            "automerge": false
        }
    ]
}
