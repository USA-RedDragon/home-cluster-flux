{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Path of Titans",
  "uid": "path-of-titans",
  "tags": ["path-of-titans", "games"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Players online",
      "description": "Live player count from the A2S query port.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(a2s_server_players)", "instant": true, "legendFormat": "players" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tick rate",
      "description": "Average server tick rate. The server targets 60. Sustained drops below ~48 are what players feel as lag, and this moves before CPU or memory show anything.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(pot_tick_rate_average)", "instant": true, "legendFormat": "tick" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 60,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 30 },
              { "color": "#0ca30c", "value": 48 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Admins online",
      "description": "Connected players whose Alderon ID appears in the server's admin list.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(pot_rcon_admins_online)", "instant": true, "legendFormat": "admins" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Server reachable",
      "description": "Whether the server answers A2S queries. Independent of whether it is listed publicly.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(a2s_server_up)", "instant": true, "legendFormat": "up" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#0ca30c", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Map / weather",
      "description": "The map the server is running and the weather it currently reports. ServerMap=Island is the Gondwa map.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "pot_rcon_server_map == 1", "instant": true, "legendFormat": "{{map}}" },
        { "refId": "B", "expr": "pot_rcon_weather == 1", "instant": true, "legendFormat": "{{weather}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },

    {
      "type": "row",
      "title": "Players",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Players online",
      "description": "Single series, so no legend is needed — the title names it. The dashed line is the configured slot cap.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "max(a2s_server_players)", "legendFormat": "Players" },
        { "refId": "B", "expr": "max(a2s_server_max_players)", "legendFormat": "Slot cap" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Players" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "Slot cap" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 }
            ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Joins and leaves per hour",
      "description": "Turnover rate. Joins persistently outrunning leaves with a flat player count means people are bouncing straight back out.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pot_player_connects_total[15m])) * 3600", "legendFormat": "Joins" },
        { "refId": "B", "expr": "sum(rate(pot_player_disconnects_total[15m])) * 3600", "legendFormat": "Leaves" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Joins" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "Leaves" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] }
        ]
      }
    },

    {
      "type": "row",
      "title": "Server performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tick rate",
      "description": "The load signal that matters. Average pulling away from the 60 target is what players experience as degradation, and it moves before any resource metric does.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "max(pot_tick_rate_average)", "legendFormat": "Average" },
        { "refId": "B", "expr": "max(pot_tick_rate_current)", "legendFormat": "Current" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 65,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 48 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Average" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "Current" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } },
              { "id": "custom.fillOpacity", "value": 0 }
            ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Both series are percentages of the container's CPU limit, so they share one axis. Throttling is the one that hurts: it stalls the game thread mid-tick and every player feels it at once.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"path-of-titans\",container=\"path-of-titans\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"path-of-titans\",container=\"path-of-titans\",resource=\"cpu\"}) * 100",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"path-of-titans\",container=\"path-of-titans\"}[5m])) / sum(rate(container_cpu_cfs_periods_total{namespace=\"path-of-titans\",container=\"path-of-titans\"}[5m])) * 100",
          "legendFormat": "Throttled"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Used" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "Throttled" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "Percentage of the container memory limit. An OOM kill disconnects every player at once, so headroom here matters more than the absolute number.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(container_memory_working_set_bytes{namespace=\"path-of-titans\",container=\"path-of-titans\"}) / max(kube_pod_container_resource_limits{namespace=\"path-of-titans\",container=\"path-of-titans\",resource=\"memory\"}) * 100",
          "legendFormat": "Used"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#d03b3b", "value": 85 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Who's playing",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Species",
      "description": "Magnitude by category, so one hue rather than a colour per species — the bar length carries the value and the names are read directly off the rows.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum by (species) (pot_rcon_players_by_species) > 0", "instant": true, "legendFormat": "{{species}}" }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "sortBy": "Value",
        "sortDesc": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Growth",
      "description": "Ordered bands from hatchling to fully grown, so the ramp runs light to dark rather than using unrelated hues.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 7, "x": 8, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum by (band) (pot_rcon_players_by_growth)", "instant": true, "legendFormat": "{{band}}" }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "#86b6ef" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "0.25-0.5" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "0.5-0.75" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1c5cab" } } ] },
          { "matcher": { "id": "byName", "options": "0.75-1.01" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#0d366b" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "How spread out players are",
      "description": "Distance from the group centre, in metres. Clustering is what drives replication cost up faster than player count alone — a tick rate dip with this falling means everyone piled into one place.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "max(pot_rcon_dispersion_median_units) / 100", "legendFormat": "Median" },
        { "refId": "B", "expr": "max(pot_rcon_dispersion_p90_units) / 100", "legendFormat": "90th percentile" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Median" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "90th percentile" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] }
        ]
      }
    },

    {
      "type": "row",
      "title": "Sessions and moderation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Session length",
      "description": "How long people stay. A median collapsing toward a couple of minutes means players are joining and leaving again, which the player count alone will not show because the seat gets refilled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(pot_session_duration_seconds_bucket[1h])))", "legendFormat": "Median" },
        { "refId": "B", "expr": "histogram_quantile(0.9, sum by (le) (rate(pot_session_duration_seconds_bucket[1h])))", "legendFormat": "90th percentile" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Median" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "90th percentile" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Moderation lists",
      "description": "Entries still in force in the game's own ban, mute and whitelist files. An enforced whitelist reading zero rejects every join while the server otherwise looks healthy.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 34 },
      "targets": [
        { "refId": "A", "expr": "sum by (list) (pot_rcon_moderation_active)", "instant": true, "legendFormat": "{{list}}" }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "#3987e5" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "mutes" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
          { "matcher": { "id": "byName", "options": "whitelist" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Biggest group",
      "description": "Most players within the configured cluster radius of any one player.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 34 },
      "targets": [
        { "refId": "A", "expr": "max(pot_rcon_max_cluster_players)", "instant": true, "legendFormat": "players" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "value", "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#3987e5" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Game time of day",
      "description": "The in-game clock as the server reports it.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 38 },
      "targets": [
        { "refId": "A", "expr": "max(pot_rcon_time_of_day)", "instant": true, "legendFormat": "time" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "none", "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Connectivity and collectors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "Server-list heartbeat",
          "description": "Successful pulses per minute to the Alderon server list. If this stops, the server vanishes from the public list and nobody new can find it — while it keeps running, holds tick rate and answers queries normally.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 43 },
          "targets": [
            { "refId": "A", "expr": "sum(rate(pot_alderon_pulse_total{code=\"200\"}[10m])) * 60", "legendFormat": "Successful pulses" }
          ],
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single" }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short", "decimals": 2, "min": 0,
              "color": { "mode": "fixed", "fixedColor": "#3987e5" },
              "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "BattlEye master",
          "description": "Failures reaching the BattlEye master. While these occur, bans are not being verified.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 43 },
          "targets": [
            { "refId": "A", "expr": "sum by (event) (increase(pot_battleye_master_events_total[10m]))", "legendFormat": "{{event}}" }
          ],
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short", "decimals": 0, "min": 0,
              "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" }
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "ban_check_timeout" },
                "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
              { "matcher": { "id": "byName", "options": "connect_failed" },
                "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
              { "matcher": { "id": "byName", "options": "disconnected" },
                "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] }
            ]
          }
        },
        {
          "type": "timeseries",
          "title": "Collectors up",
          "description": "The two exporters this dashboard depends on. If either drops, the panels above go stale rather than wrong — check here first when something looks frozen.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 43 },
          "targets": [
            { "refId": "A", "expr": "max(a2s_server_up)", "legendFormat": "A2S query" },
            { "refId": "B", "expr": "max(pot_rcon_up)", "legendFormat": "RCON" }
          ],
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short", "decimals": 0, "min": 0, "max": 1.2,
              "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "lineInterpolation": "stepAfter" }
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "A2S query" },
                "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
              { "matcher": { "id": "byName", "options": "RCON" },
                "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] }
            ]
          }
        }
      ]
    }
  ]
}
